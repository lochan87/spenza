{
  "emulators": { "auth": { "port": 9099 }, "firestore": { "port": 8080 }, "functions": { "port": 5001 }, "singleProjectMode": true },
  "functions": [
    {
      "source": "functions",
      "codebase": "imports",
      "runtime": "nodejs22",
      "predeploy": [
        "node scripts/guardDeploy.mjs functions"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "node scripts/guardDeploy.mjs firestore"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "node scripts/guardDeploy.mjs hosting"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": [
      "node scripts/guardDeploy.mjs storage"
    ]
  }
}
