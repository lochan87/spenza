rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    // Returns true if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the authenticated user owns this data path
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── users/{uid} — top-level user document ────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // ── profile subcollection ──────────────────────────────────────────────
      match /profile/{document=**} {
        allow read, write: if isOwner(uid);
      }

      // ── transactions subcollection ────────────────────────────────────────
      match /transactions/{transactionId} {
        function splitHasRepayment(s) {
          return s.get('settledAt', null) != null
              || (s.get('repaidPaise', 0) is int && s.get('repaidPaise', 0) > 0);
        }

        function splitsHaveRepayments(splits) {
          return (splits.size() > 0 && splitHasRepayment(splits[0]))
              || (splits.size() > 1 && splitHasRepayment(splits[1]))
              || (splits.size() > 2 && splitHasRepayment(splits[2]))
              || (splits.size() > 3 && splitHasRepayment(splits[3]))
              || (splits.size() > 4 && splitHasRepayment(splits[4]))
              || (splits.size() > 5 && splitHasRepayment(splits[5]))
              || (splits.size() > 6 && splitHasRepayment(splits[6]))
              || (splits.size() > 7 && splitHasRepayment(splits[7]))
              || (splits.size() > 8 && splitHasRepayment(splits[8]))
              || (splits.size() > 9 && splitHasRepayment(splits[9]));
        }

        function hasRepaymentHistory(d) {
          return d.get('reimbursementStatus', 'none') in ['partial', 'settled']
              || (d.get('splits', []).size() > 10 || splitsHaveRepayments(d.get('splits', [])));
        }

        function validPayment(d) {
          return !d.keys().hasAny(['paymentMode'])
              || (d.paymentMode in ['Cash', 'Other'] && d.get('paymentAccountId', null) == null)
              || (d.paymentMode in ['UPI', 'Bank Transfer', 'Card'] && d.get('paymentAccountId', null) is string && d.paymentAccountId.size() > 0);
        }

        function validTypes(d) {
          return (!d.keys().hasAny(['type']) || d.type in ['everyday', 'recurring', 'one-time', 'trip', 'gift-event', 'reimbursable'])
              && (!d.keys().hasAny(['description']) || (d.description is string && d.description.size() <= 500))
              && (!d.keys().hasAny(['categoryId']) || (d.categoryId is string && d.categoryId.size() <= 200))
              && (!d.keys().hasAny(['recoverablePaise']) || (d.recoverablePaise is int && d.recoverablePaise >= 0 && (!d.keys().hasAny(['amountPaise']) || d.recoverablePaise <= d.amountPaise)))
              && (!d.keys().hasAny(['reimbursementStatus']) || d.reimbursementStatus in ['none', 'pending', 'partial', 'settled'])
              && validPayment(d);
        }

        function validAmount(d) {
          return !d.keys().hasAny(['amountPaise']) || (d.amountPaise is int && d.amountPaise > 0);
        }

        function validStatusTransition(existing, incoming) {
          return !hasRepaymentHistory(existing)
              || (incoming.get('reimbursementStatus', 'none') in ['partial', 'settled'] &&
                  !(existing.get('reimbursementStatus', 'none') == 'settled' && incoming.get('reimbursementStatus', 'none') != 'settled'));
        }

        function immutableFieldsPreserved(existing, incoming) {
          return (!existing.keys().hasAny(['id']) || (incoming.keys().hasAny(['id']) && incoming.id == existing.id))
              && (!existing.keys().hasAny(['createdAt']) || (incoming.keys().hasAny(['createdAt']) && incoming.createdAt == existing.createdAt))
              && (!existing.keys().hasAny(['isImported']) || (incoming.keys().hasAny(['isImported']) && incoming.isImported == existing.isImported))
              && (!existing.keys().hasAny(['importOperationId']) || (incoming.keys().hasAny(['importOperationId']) && incoming.importOperationId == existing.importOperationId))
              && (!existing.keys().hasAny(['recurringItemId']) || (incoming.keys().hasAny(['recurringItemId']) && incoming.recurringItemId == existing.recurringItemId));
        }

        function validCreation(d) {
          return !hasRepaymentHistory(d)
              && (d.get('recoverablePaise', 0) == 0
                  ? (d.get('reimbursementStatus', 'none') == 'none' && d.get('splits', []).size() == 0)
                  : (d.get('reimbursementStatus', 'none') == 'pending' && d.get('splits', []).size() > 0 && d.get('splits', []).size() <= 10));
        }

        allow read: if isOwner(uid);

        allow delete: if isOwner(uid) && resource != null && !hasRepaymentHistory(resource.data);

        allow create: if isOwner(uid)
          && request.resource.data.get('amountPaise', 0) is int
          && request.resource.data.get('amountPaise', 0) > 0
          && validTypes(request.resource.data)
          && validCreation(request.resource.data);

        allow update: if isOwner(uid)
          && (resource == null || (
              validAmount(request.resource.data)
              && validTypes(request.resource.data)
              && immutableFieldsPreserved(resource.data, request.resource.data)
              && validStatusTransition(resource.data, request.resource.data)
          ));
      }

      // ── categories subcollection ──────────────────────────────────────────
      match /categories/{categoryId} {
        allow read, write: if isOwner(uid);
      }

      // ── paymentAccounts subcollection ─────────────────────────────────────
      match /paymentAccounts/{accountId} {
        allow read, write: if isOwner(uid);
      }

      // ── budgets subcollection ─────────────────────────────────────────────
      match /budgets/{budgetId} {
        allow read, write: if isOwner(uid);
      }

      // ── trips subcollection ───────────────────────────────────────────────
      match /trips/{tripId} {
        allow read, write: if isOwner(uid);
      }

      // ── recurring subcollection ───────────────────────────────────────────
      match /recurring/{recurringId} {
        allow read, write: if isOwner(uid);
      }

      // ── people subcollection ──────────────────────────────────────────────
      match /people/{personId} {
        allow read, write: if isOwner(uid);
      }

      // Import plans are immutable after preparation. All paths remain owner-only.
      match /importOperations/{operationId} {
        function validHeader(d) {
          return d.keys().hasOnly(['version', 'ownerUid', 'operationId', 'fingerprint', 'fileName', 'hashes', 'total', 'skipped', 'ready'])
            && d.version == 2 && d.ownerUid == uid && d.operationId == operationId
            && operationId.matches('^[a-f0-9]{64}(-[a-f0-9-]{36})?$')
            && d.fingerprint is string && d.fingerprint.matches('^[a-f0-9]{64}$')
            && operationId.matches('^' + d.fingerprint + '(-[a-f0-9-]{36})?$')
            && d.fileName is string && d.fileName.size() > 0 && d.fileName.size() <= 250
            && d.hashes is list && d.hashes.size() > 0 && d.hashes.size() <= 500
            && d.total is int && d.total > 0 && d.total <= 10000
            && d.skipped is int && d.skipped >= 0 && d.skipped <= 1000000
            && d.ready is bool;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validHeader(request.resource.data) && request.resource.data.ready == false;
        allow update: if isOwner(uid) && validHeader(request.resource.data)
          && resource.data.ready == false && request.resource.data.ready == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']);
        allow delete: if false;

        match /chunks/{chunkId} {
          function header() { return get(/databases/$(database)/documents/users/$(uid)/importOperations/$(operationId)).data; }
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && header().version == 2 && header().ready == false
            && request.resource.data.keys().hasOnly(['index', 'hash', 'payload'])
            && request.resource.data.index is int && request.resource.data.index >= 0
            && request.resource.data.index < header().hashes.size()
            && chunkId == string(request.resource.data.index)
            && request.resource.data.hash == header().hashes[request.resource.data.index]
            && request.resource.data.hash is string && request.resource.data.hash.matches('^[a-f0-9]{64}$')
            && request.resource.data.payload is string && request.resource.data.payload.toUtf8().size() <= 90000;
          allow update, delete: if false;
        }
        // Legacy proof is untrusted; all completion proof is server-owned.
        match /receipts/{chunkId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /tripReceipts/{tripId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /trustedV2Receipts/{chunkId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /trustedV2Trips/{tripId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /trustedV2State/{stateId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // ── insights subcollection ────────────────────────────────────────────
      // Stores the cached insights summary document at insights/summary.
      // Added Phase 4 — was missing from initial rules, causing permission errors.
      match /insights/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
