rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    // Returns true if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the authenticated user owns this data path
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── users/{uid} — top-level user document ────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // ── profile subcollection ──────────────────────────────────────────────
      match /profile/{document=**} {
        allow read, write: if isOwner(uid);
      }

      // ── transactions subcollection ────────────────────────────────────────
      match /transactions/{transactionId} {
        function splitHasRepayment(s) {
          return ('settledAt' in s && s.settledAt != null)
              || ('repaidPaise' in s && s.repaidPaise is int && s.repaidPaise > 0);
        }

        function splitsHaveRepayments(splits) {
          return (splits.size() > 0 && splitHasRepayment(splits[0]))
              || (splits.size() > 1 && splitHasRepayment(splits[1]))
              || (splits.size() > 2 && splitHasRepayment(splits[2]))
              || (splits.size() > 3 && splitHasRepayment(splits[3]))
              || (splits.size() > 4 && splitHasRepayment(splits[4]))
              || (splits.size() > 5 && splitHasRepayment(splits[5]))
              || (splits.size() > 6 && splitHasRepayment(splits[6]))
              || (splits.size() > 7 && splitHasRepayment(splits[7]))
              || (splits.size() > 8 && splitHasRepayment(splits[8]))
              || (splits.size() > 9 && splitHasRepayment(splits[9]));
        }

        function hasRepaymentHistory(d) {
          return d.get('settledAt', null) != null
              || d.get('reimbursementStatus', 'none') in ['partial', 'settled']
              || (d.get('splits', []).size() > 10 || splitsHaveRepayments(d.get('splits', [])));
        }

        function validPayment(d) {
          return (d.get('paymentMode', 'Cash') in ['Cash', 'Other'] && d.get('paymentAccountId', null) == null)
              || (d.get('paymentMode', '') in ['UPI', 'Bank Transfer', 'Card']
                  && d.get('paymentAccountId', null) is string
                  && d.get('paymentAccountId', '').size() > 0
                  && d.get('paymentAccountId', '').size() <= 200);
        }

        function validTypes(d) {
          return d.get('type', 'everyday') in ['everyday', 'recurring', 'one-time', 'trip', 'gift-event', 'reimbursable']
              && (d.get('description', '') is string && d.get('description', '').size() <= 500)
              && (d.get('categoryId', '') is string && d.get('categoryId', '').size() <= 200)
              && (d.get('recoverablePaise', 0) is int
                  && d.get('recoverablePaise', 0) >= 0
                  && d.get('recoverablePaise', 0) <= d.get('amountPaise', 0))
              && d.get('reimbursementStatus', 'none') in ['none', 'pending', 'partial', 'settled']
              && validPayment(d);
        }

        function validAmount(d) {
          return d.get('amountPaise', 0) is int && d.get('amountPaise', 0) > 0;
        }

        function immutableFieldsPreserved(existing, incoming) {
          return incoming.get('id', null) == existing.get('id', null)
              && incoming.get('createdAt', null) == existing.get('createdAt', null)
              && incoming.get('isImported', null) == existing.get('isImported', null)
              && incoming.get('importSource', null) == existing.get('importSource', null)
              && incoming.get('importOperationId', null) == existing.get('importOperationId', null)
              && incoming.get('importSourceRowId', null) == existing.get('importSourceRowId', null)
              && incoming.get('recurringItemId', null) == existing.get('recurringItemId', null)
              && incoming.get('recurringOccurrenceDate', null) == existing.get('recurringOccurrenceDate', null);
        }

        function financialFieldsNotRemoved(existing, incoming) {
          return (existing.get('amountPaise', null) == null || incoming.get('amountPaise', null) != null)
              && (existing.get('recoverablePaise', null) == null || incoming.get('recoverablePaise', null) != null)
              && (existing.get('reimbursementStatus', null) == null || incoming.get('reimbursementStatus', null) != null)
              && (existing.get('splits', null) == null || incoming.get('splits', null) != null)
              && (!hasRepaymentHistory(existing) || existing.get('personId', null) == null || incoming.get('personId', null) != null);
        }

        function financialFieldsUnchanged(existing, incoming) {
          return incoming.get('amountPaise', 0) == existing.get('amountPaise', 0)
              && incoming.get('recoverablePaise', 0) == existing.get('recoverablePaise', 0)
              && incoming.get('reimbursementStatus', 'none') == existing.get('reimbursementStatus', 'none')
              && incoming.get('splits', []) == existing.get('splits', [])
              && incoming.get('settledAt', null) == existing.get('settledAt', null)
              && incoming.get('personId', null) == existing.get('personId', null);
        }

        function validSplitItem(s) {
          return s.get('amountPaise', 0) is int && s.get('amountPaise', 0) > 0
              && s.get('repaidPaise', 0) is int && s.get('repaidPaise', 0) == 0
              && s.get('settledAt', null) == null
              && s.get('personId', '') is string && s.get('personId', '').size() > 0;
        }

        function validCreationSplits(splits) {
          return (splits.size() > 0 && validSplitItem(splits[0]))
              && (splits.size() < 2 || validSplitItem(splits[1]))
              && (splits.size() < 3 || validSplitItem(splits[2]))
              && (splits.size() < 4 || validSplitItem(splits[3]))
              && (splits.size() < 5 || validSplitItem(splits[4]))
              && (splits.size() < 6 || validSplitItem(splits[5]))
              && (splits.size() < 7 || validSplitItem(splits[6]))
              && (splits.size() < 8 || validSplitItem(splits[7]))
              && (splits.size() < 9 || validSplitItem(splits[8]))
              && (splits.size() < 10 || validSplitItem(splits[9]));
        }

        function splitSum(splits) {
          return splits[0].get('amountPaise', 0)
              + (splits.size() > 1 ? splits[1].get('amountPaise', 0) : 0)
              + (splits.size() > 2 ? splits[2].get('amountPaise', 0) : 0)
              + (splits.size() > 3 ? splits[3].get('amountPaise', 0) : 0)
              + (splits.size() > 4 ? splits[4].get('amountPaise', 0) : 0)
              + (splits.size() > 5 ? splits[5].get('amountPaise', 0) : 0)
              + (splits.size() > 6 ? splits[6].get('amountPaise', 0) : 0)
              + (splits.size() > 7 ? splits[7].get('amountPaise', 0) : 0)
              + (splits.size() > 8 ? splits[8].get('amountPaise', 0) : 0)
              + (splits.size() > 9 ? splits[9].get('amountPaise', 0) : 0);
        }

        function validCreation(d) {
          return !hasRepaymentHistory(d)
              && (d.get('recoverablePaise', 0) == 0
                  ? (d.get('reimbursementStatus', 'none') == 'none' && d.get('splits', []).size() == 0)
                  : (d.get('reimbursementStatus', 'none') == 'pending'
                     && d.get('splits', []).size() > 0
                     && d.get('splits', []).size() <= 10
                     && validCreationSplits(d.get('splits', []))
                     && splitSum(d.get('splits', [])) == d.get('recoverablePaise', 0)));
        }

        allow read: if isOwner(uid);

        allow delete: if isOwner(uid) && resource != null && !hasRepaymentHistory(resource.data);

        allow create: if isOwner(uid)
          && validAmount(request.resource.data)
          && validTypes(request.resource.data)
          && validCreation(request.resource.data);

        allow update: if isOwner(uid)
          && resource != null
          && validAmount(request.resource.data)
          && validTypes(request.resource.data)
          && immutableFieldsPreserved(resource.data, request.resource.data)
          && financialFieldsNotRemoved(resource.data, request.resource.data)
          && (
            financialFieldsUnchanged(resource.data, request.resource.data)
            || (
              !hasRepaymentHistory(resource.data)
              && validCreation(request.resource.data)
            )
          );
      }

      // ── categories subcollection ──────────────────────────────────────────
      match /categories/{categoryId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      // ── paymentAccounts subcollection ─────────────────────────────────────
      match /paymentAccounts/{accountId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      // ── budgets subcollection ─────────────────────────────────────────────
      match /budgets/{budgetId} {
        allow read, write: if isOwner(uid);
      }

      // ── trips subcollection ───────────────────────────────────────────────
      match /trips/{tripId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      // ── recurring subcollection ───────────────────────────────────────────
      match /recurring/{recurringId} {
        allow read, write: if isOwner(uid);
      }

      // ── people subcollection ──────────────────────────────────────────────
      match /people/{personId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      // ── repaymentReceipts subcollection ──────────────────────────────────
      // Receipts are server-owned; clients cannot forge or delete them.
      match /repaymentReceipts/{receiptId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Import plans are immutable after preparation. All paths remain owner-only.
      match /importOperations/{operationId} {
        function validHeader(d) {
          return d.keys().hasOnly(['version', 'ownerUid', 'operationId', 'fingerprint', 'fileName', 'hashes', 'total', 'skipped', 'ready'])
            && d.version == 2 && d.ownerUid == uid && d.operationId == operationId
            && operationId.matches('^[a-f0-9]{64}(-[a-f0-9-]{36})?$')
            && d.fingerprint is string && d.fingerprint.matches('^[a-f0-9]{64}$')
            && operationId.matches('^' + d.fingerprint + '(-[a-f0-9-]{36})?$')
            && d.fileName is string && d.fileName.size() > 0 && d.fileName.size() <= 250
            && d.hashes is list && d.hashes.size() > 0 && d.hashes.size() <= 500
            && d.total is int && d.total > 0 && d.total <= 10000
            && d.skipped is int && d.skipped >= 0 && d.skipped <= 1000000
            && d.ready is bool;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validHeader(request.resource.data) && request.resource.data.ready == false;
        allow update: if isOwner(uid) && validHeader(request.resource.data)
          && resource.data.ready == false && request.resource.data.ready == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']);
        allow delete: if false;

        match /chunks/{chunkId} {
          function header() { return get(/databases/$(database)/documents/users/$(uid)/importOperations/$(operationId)).data; }
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && header().version == 2 && header().ready == false
            && request.resource.data.keys().hasOnly(['index', 'hash', 'payload'])
            && request.resource.data.index is int && request.resource.data.index >= 0
            && request.resource.data.index < header().hashes.size()
            && chunkId == string(request.resource.data.index)
            && request.resource.data.hash == header().hashes[request.resource.data.index]
            && request.resource.data.hash is string && request.resource.data.hash.matches('^[a-f0-9]{64}$')
            && request.resource.data.payload is string && request.resource.data.payload.toUtf8().size() <= 90000;
          allow update, delete: if false;
        }
        // Legacy proof is untrusted; all completion proof is server-owned.
        match /receipts/{chunkId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /tripReceipts/{tripId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /trustedV2Receipts/{chunkId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /trustedV2Trips/{tripId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /trustedV2State/{stateId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // ── insights subcollection ────────────────────────────────────────────
      // Stores the cached insights summary document at insights/summary.
      // Added Phase 4 — was missing from initial rules, causing permission errors.
      match /insights/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
